{
  "name": "dsh-hub-bot",
  "version": "0.20.0",
  "private": true,
  "description": "Hub Bot: a three-layer owner-agent personal bot as a DSH cordis bundle. Feishu/GitHub sources route into owner sessions through prompt injection; this package is the bundle skeleton: state directory, versioned SQLite store, owner agent presets, and the session injection/inspection API.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ghost233/GhostDSHHubBot.git"
  },
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./router-tools": "./src/router-tools.js",
    "./owner-tools": "./src/owner-tools.js",
    "./package.json": "./package.json",
    "./client": "./client/client.js"
  },
  "files": [
    "src",
    "panel",
    "client",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "manifestVersion": 1,
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-plugin-manager",
        "@deepseek-ai/dsh-api-remotes"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "test": "node --test \"test/*.test.js\""
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": "^0.2.1-alpha.2"
  },
  "dependencies": {
    "@larksuiteoapi/node-sdk": "^1.76.0",
    "@deepseek-ai/schemastery": "^3.19.0",
    "@deepseek-ai/dsh-typert-protocol": "^0.2.2-rc.4",
    "@deepseek-ai/cordis": "~4.1.0"
  }
}
